<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>viser_ros2_bridge</name>
    <version>0.0.1</version>
    <description>ROS2 bridge for visualizing common ROS2 data in viser</description>
    <maintainer email="julian.mueller@iwb.tum.de">jmueller</maintainer>
    <license>LGPL-3.0-or-later</license>

    <depend>rclpy</depend>
    <depend>geometry_msgs</depend>
    <depend>sensor_msgs</depend>
    <depend>sensor_msgs_py</depend>
    <depend>shape_msgs</depend>
    <depend>std_msgs</depend>
    <depend>std_srvs</depend>
    <depend>tf2_msgs</depend>
    <depend>visualization_msgs</depend>

    <depend>python3-numpy</depend>
    <depend>python3-trimesh</depend>
    <!-- <depend>python3-viser</depend> not available yet -->

    <depend>rviz2_utils</depend>
    <depend>tf2_utils</depend>

    <test_depend>ament_copyright</test_depend>
    <test_depend>ament_flake8</test_depend>
    <test_depend>ament_pep257</test_depend>
    <test_depend>python3-pytest</test_depend>

    <export>
        <build_type>ament_python</build_type>
    </export>
</package>